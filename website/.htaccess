# Evos website settings for an Apache host such as Hostinger.
# If the host already has a .htaccess file, add these lines to it instead of replacing it.
# This file's name starts with a dot, so macOS hides it: check it is included in every upload.

# Send www.<domain> to <domain>, keeping the path. Written without the domain name, which is not
# chosen yet. No HTTP-to-HTTPS rule on purpose: Hostinger forces HTTPS itself, and a second rule
# here can cause a redirect loop.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# Our own "page not found" page instead of the host's.
ErrorDocument 404 /404.html

# Send text files compressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain image/svg+xml
</IfModule>
