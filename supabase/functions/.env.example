# Optional. Everything the functions need is a row of the app_config table
# (see docs/09-deep-link-onboarding.md); a secret here is used only when the
# row of the same purpose is empty. Push with:
#   ./tool/setup_backend.sh secrets

# Row: send_sms_hook_secret
SEND_SMS_HOOK_SECRET=
# Row: fast2sms
FAST2SMS_API_KEY=
# Row: fast2sms_dlt_sender_id
FAST2SMS_SENDER_ID=
# Row: fast2sms_dlt_te_id
FAST2SMS_MESSAGE_ID=

# Rows: cashfree_app_id, cashfree_secret_key, cashfree_environment
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "production" takes real money. Anything else is sandbox.
CASHFREE_ENVIRONMENT=sandbox
